<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Detalhes do Usuário | Painel Administrativo | Larizinha Store</title>
  <meta name="description" content="Detalhes e ações para um usuário específico da Larizinha Store." />
  <style>
    /* ===== RESET & BASE ===== */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --bg-dark: #0b0e14;
      --bg-card: #121722;
      --bg-card-hover: #1a2230;
      --primary: #7c5cff;
      --primary-hover: #967aff;
      --accent: #00d4aa;
      --text-primary: #f0f2f5;
      --text-secondary: #aab2c5;
      --border: #232a38;
      --radius: 12px;
      --shadow: 0 8px 20px rgba(0,0,0,0.3);
      --sidebar-width: 260px;
    }

    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg-dark); color: var(--text-primary); line-height: 1.6; display: flex; min-height: 100vh; }
    a { text-decoration: none; color: inherit; transition: color 0.3s; }

    /* ===== SIDEBAR ===== */
    .sidebar { width: var(--sidebar-width); background: var(--bg-card); border-right: 1px solid var(--border); display: flex; flex-direction: column; position: fixed; top: 0; left: 0; bottom: 0; z-index: 200; transition: transform 0.3s; }
    .sidebar-header { padding: 20px; border-bottom: 1px solid var(--border); }
    .sidebar-logo { display: flex; align-items: center; gap: 10px; font-size: 1.3rem; font-weight: 700; color: var(--primary); }
    .sidebar-logo-icon { width: 32px; height: 32px; background: linear-gradient(135deg, var(--primary), var(--accent)); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1rem; }
    .sidebar-nav { flex: 1; overflow-y: auto; padding: 10px 0; }
    .sidebar-nav::-webkit-scrollbar { width: 5px; }
    .sidebar-nav::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }
    .sidebar-section { padding: 10px 20px 5px; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-secondary); }
    .sidebar-link { display: flex; align-items: center; gap: 12px; padding: 10px 20px; color: var(--text-secondary); font-weight: 500; transition: all 0.3s; border-left: 3px solid transparent; }
    .sidebar-link:hover { background: var(--bg-card-hover); color: var(--text-primary); }
    .sidebar-link.active { background: rgba(124,92,255,0.1); color: var(--primary); border-left-color: var(--primary); }
    .sidebar-link .icon { width: 22px; text-align: center; font-size: 1.1rem; }
    .sidebar-footer { padding: 15px 20px; border-top: 1px solid var(--border); }
    .admin-info { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .admin-avatar { width: 36px; height: 36px; background: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: white; }
    .admin-details { flex: 1; }
    .admin-name { font-weight: 600; font-size: 0.9rem; }
    .admin-role { font-size: 0.75rem; color: var(--text-secondary); }
    .btn-logout { width: 100%; padding: 8px; background: transparent; border: 1px solid var(--border); border-radius: 6px; color: var(--text-secondary); cursor: pointer; transition: all 0.3s; font-size: 0.85rem; }
    .btn-logout:hover { border-color: #ff6b6b; color: #ff6b6b; }

    /* ===== MAIN ===== */
    .main-content { flex: 1; margin-left: var(--sidebar-width); padding: 20px; }
    .topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; flex-wrap: wrap; gap: 15px; }
    .topbar h1 { font-size: 1.8rem; font-weight: 700; }
    .topbar-actions { display: flex; gap: 10px; }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.3s; border: none; font-size: 0.9rem; background: transparent; color: var(--text-primary); }
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-hover); transform: translateY(-2px); box-shadow: 0 8px 16px rgba(124,92,255,0.3); }
    .btn-outline { border: 1px solid var(--border); }
    .btn-outline:hover { border-color: var(--primary); color: var(--primary); }
    .btn-danger { color: #ff6b6b; border: 1px solid rgba(255,107,107,0.3); }
    .btn-danger:hover { background: rgba(255,107,107,0.1); }
    .btn-sm { padding: 6px 12px; font-size: 0.8rem; border-radius: 6px; }

    /* ===== PROFILE CARD ===== */
    .profile-card { background: var(--bg-card); border-radius: var(--radius); padding: 25px; border: 1px solid var(--border); margin-bottom: 25px; display: flex; flex-wrap: wrap; gap: 20px; }
    .profile-avatar { width: 80px; height: 80px; background: linear-gradient(135deg, var(--primary), var(--accent)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 700; color: white; flex-shrink: 0; }
    .profile-info { flex: 1; min-width: 200px; }
    .profile-info h2 { margin-bottom: 5px; font-size: 1.5rem; }
    .profile-info .username { color: var(--text-secondary); margin-bottom: 10px; }
    .profile-details { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
    .profile-detail-item { font-size: 0.9rem; }
    .profile-detail-item strong { color: var(--text-secondary); display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .profile-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }

    /* ===== TABS ===== */
    .tabs { display: flex; gap: 5px; margin-bottom: 20px; border-bottom: 1px solid var(--border); overflow-x: auto; }
    .tab-btn { padding: 10px 20px; background: none; border: none; color: var(--text-secondary); cursor: pointer; font-weight: 600; font-size: 0.9rem; border-bottom: 2px solid transparent; transition: all 0.3s; white-space: nowrap; }
    .tab-btn:hover { color: var(--text-primary); }
    .tab-btn.active { color: var(--primary); border-bottom-color: var(--primary); }
    .tab-content { display: none; background: var(--bg-card); border-radius: var(--radius); padding: 20px; border: 1px solid var(--border); }
    .tab-content.active { display: block; }

    table { width: 100%; border-collapse: collapse; min-width: 600px; }
    th { text-align: left; padding: 10px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); border-bottom: 1px solid var(--border); }
    td { padding: 10px; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
    .status-badge { display: inline-block; padding: 4px 10px; border-radius: 50px; font-size: 0.75rem; font-weight: 600; }
    .status-active { background: rgba(0,212,170,0.15); color: var(--accent); }
    .status-blocked { background: rgba(255,107,107,0.15); color: #ff6b6b; }
    .status-pending { background: rgba(255,193,7,0.15); color: #ffc107; }
    .status-approved { background: rgba(0,212,170,0.15); color: var(--accent); }

    /* ===== MODAL ===== */
    .modal-overlay { display: none; position: fixed; top:0; left:0; right:0; bottom:0; background: rgba(0,0,0,0.7); z-index: 500; align-items: center; justify-content: center; }
    .modal-overlay.show { display: flex; }
    .modal { background: var(--bg-card); border-radius: var(--radius); padding: 25px; width: 90%; max-width: 500px; border: 1px solid var(--border); }
    .modal h3 { margin-bottom: 15px; }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; margin-bottom: 5px; color: var(--text-secondary); font-size: 0.9rem; }
    .form-group input, .form-group textarea { width: 100%; padding: 10px; background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; color: var(--text-primary); }
    .modal-buttons { display: flex; gap: 10px; justify-content: flex-end; }

    /* ===== RESPONSIVO ===== */
    .sidebar-toggle { display: none; background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-primary); }
    @media (max-width: 768px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.open { transform: translateX(0); }
      .main-content { margin-left: 0; }
      .sidebar-toggle { display: block; }
    }

    .loading { text-align: center; padding: 40px; color: var(--text-secondary); }
    .spinner { display: inline-block; width: 40px; height: 40px; border: 4px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 1s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>

  <!-- SIDEBAR (idêntica) -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <a href="dashboard.html" class="sidebar-logo">
        <span class="sidebar-logo-icon">🛍️</span>
        Larizinha Store
      </a>
    </div>
    <nav class="sidebar-nav">
      <div class="sidebar-section">Principal</div>
      <a href="dashboard.html" class="sidebar-link"><span class="icon">📊</span> Dashboard</a>
      <a href="usuarios.html" class="sidebar-link active"><span class="icon">👥</span> Usuários</a>
      <a href="produtos.html" class="sidebar-link"><span class="icon">📦</span> Produtos</a>
      <a href="categorias.html" class="sidebar-link"><span class="icon">🏷️</span> Categorias</a>
      <a href="estoque.html" class="sidebar-link"><span class="icon">📋</span> Estoque</a>
      <a href="pedidos.html" class="sidebar-link"><span class="icon">🛒</span> Pedidos</a>
      <div class="sidebar-section">Financeiro</div>
      <a href="pagamentos.html" class="sidebar-link"><span class="icon">💳</span> Pagamentos</a>
      <a href="recargas.html" class="sidebar-link"><span class="icon">🔋</span> Recargas</a>
      <a href="carteira.html" class="sidebar-link"><span class="icon">👛</span> Carteira</a>
      <a href="giftcards.html" class="sidebar-link"><span class="icon">🎁</span> Gift Cards</a>
      <a href="afiliados.html" class="sidebar-link"><span class="icon">🤝</span> Afiliados</a>
      <a href="saques.html" class="sidebar-link"><span class="icon">💰</span> Saques</a>
      <div class="sidebar-section">Comunicação</div>
      <a href="rankings.html" class="sidebar-link"><span class="icon">🏆</span> Rankings</a>
      <a href="alertas.html" class="sidebar-link"><span class="icon">🔔</span> Alertas</a>
      <a href="mensagens.html" class="sidebar-link"><span class="icon">💬</span> Mensagens</a>
      <a href="botoes.html" class="sidebar-link"><span class="icon">🔘</span> Botões</a>
      <a href="menus.html" class="sidebar-link"><span class="icon">📑</span> Menus</a>
      <a href="comandos.html" class="sidebar-link"><span class="icon">⌨️</span> Comandos</a>
      <div class="sidebar-section">Integrações</div>
      <a href="telegram.html" class="sidebar-link"><span class="icon">📱</span> Telegram</a>
      <a href="whatsapp.html" class="sidebar-link"><span class="icon">💚</span> WhatsApp</a>
      <a href="email.html" class="sidebar-link"><span class="icon">📧</span> E-mail</a>
      <a href="mercadopago.html" class="sidebar-link"><span class="icon">💠</span> Mercado Pago</a>
      <div class="sidebar-section">Sistema</div>
      <a href="configuracoes.html" class="sidebar-link"><span class="icon">⚙️</span> Configurações</a>
      <a href="seguranca.html" class="sidebar-link"><span class="icon">🔒</span> Segurança</a>
      <a href="logs.html" class="sidebar-link"><span class="icon">📄</span> Logs</a>
      <a href="estatisticas.html" class="sidebar-link"><span class="icon">📈</span> Estatísticas</a>
      <a href="administradores.html" class="sidebar-link"><span class="icon">🛡️</span> Administradores</a>
    </nav>
    <div class="sidebar-footer">
      <div class="admin-info">
        <div class="admin-avatar">A</div>
        <div class="admin-details"><div class="admin-name">Admin</div><div class="admin-role">Super Admin</div></div>
      </div>
      <button class="btn-logout" onclick="window.location.href='../login.html'">Sair do painel</button>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    <div class="topbar">
      <div style="display:flex;align-items:center;gap:15px;">
        <button class="sidebar-toggle" id="sidebarToggle">☰</button>
        <h1>Detalhes do Usuário</h1>
      </div>
      <div class="topbar-actions">
        <a href="usuarios.html" class="btn btn-outline">← Voltar</a>
      </div>
    </div>

    <!-- Área de carregamento -->
    <div id="loading" class="loading"><div class="spinner"></div><p>Carregando usuário...</p></div>

    <!-- Conteúdo principal (oculto até carregar) -->
    <div id="userContent" style="display:none;">
      <!-- Perfil -->
      <div class="profile-card">
        <div class="profile-avatar" id="userAvatar">?</div>
        <div class="profile-info">
          <h2 id="userName">-</h2>
          <p class="username" id="userUsername">-</p>
          <div class="profile-details">
            <div class="profile-detail-item"><strong>ID</strong><span id="userDbId">-</span></div>
            <div class="profile-detail-item"><strong>Telegram ID</strong><span id="userTelegramId">-</span></div>
            <div class="profile-detail-item"><strong>E-mail</strong><span id="userEmail">-</span></div>
            <div class="profile-detail-item"><strong>WhatsApp</strong><span id="userWhatsapp">-</span></div>
            <div class="profile-detail-item"><strong>Saldo</strong><span id="userBalance">-</span></div>
            <div class="profile-detail-item"><strong>Compras</strong><span id="userPurchases">-</span></div>
            <div class="profile-detail-item"><strong>Afiliado</strong><span id="userAffiliate">-</span></div>
            <div class="profile-detail-item"><strong>Status</strong><span id="userStatus"></span></div>
          </div>
        </div>
        <div class="profile-actions">
          <button class="btn btn-primary" onclick="abrirModal('modalAjustarSaldo')">💰 Ajustar Saldo</button>
          <button class="btn btn-outline" onclick="abrirModal('modalEnviarMensagem')">📨 Mensagem</button>
          <button class="btn btn-danger" id="btnToggleStatus" onclick="toggleStatus()">🚫 Bloquear</button>
        </div>
      </div>

      <!-- Tabs -->
      <div class="tabs">
        <button class="tab-btn active" data-tab="compras">🛒 Compras</button>
        <button class="tab-btn" data-tab="recargas">💠 Recargas</button>
        <button class="tab-btn" data-tab="afiliados">🤝 Afiliados</button>
        <button class="tab-btn" data-tab="alertas">🔔 Alertas</button>
        <button class="tab-btn" data-tab="logs">📄 Logs</button>
      </div>

      <!-- Conteúdo das tabs -->
      <div class="tab-content active" id="tab-compras"></div>
      <div class="tab-content" id="tab-recargas"></div>
      <div class="tab-content" id="tab-afiliados"></div>
      <div class="tab-content" id="tab-alertas"></div>
      <div class="tab-content" id="tab-logs"></div>
    </div>
  </main>

  <!-- MODAIS -->
  <div class="modal-overlay" id="modalAjustarSaldo">
    <div class="modal">
      <h3>Ajustar Saldo</h3>
      <div class="form-group"><label>Valor (positivo/negativo)</label><input type="number" id="ajusteValor" step="0.01" placeholder="Ex: 50.00" /></div>
      <div class="form-group"><label>Motivo (obrigatório)</label><input type="text" id="ajusteMotivo" placeholder="Motivo do ajuste" /></div>
      <div class="modal-buttons">
        <button class="btn btn-outline" onclick="fecharModal('modalAjustarSaldo')">Cancelar</button>
        <button class="btn btn-primary" onclick="confirmarAjuste()">Confirmar</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="modalEnviarMensagem">
    <div class="modal">
      <h3>Enviar Mensagem</h3>
      <div class="form-group"><label>Mensagem</label><textarea id="mensagemTexto" rows="4" placeholder="Digite a mensagem..."></textarea></div>
      <div class="modal-buttons">
        <button class="btn btn-outline" onclick="fecharModal('modalEnviarMensagem')">Cancelar</button>
        <button class="btn btn-primary" onclick="confirmarEnvioMensagem()">Enviar</button>
      </div>
    </div>
  </div>

  <script>
    const API_URL = '/api/admin';
    let usuarioAtual = null;

    // ===== PEGAR ID DA URL =====
    const urlParams = new URLSearchParams(window.location.search);
    const userId = urlParams.get('id');

    if (!userId) {
      document.getElementById('loading').innerHTML = '<p style="color:#ff6b6b;">ID de usuário não fornecido.</p>';
    } else {
      carregarUsuario(userId);
    }

    // ===== SIDEBAR TOGGLE =====
    document.getElementById('sidebarToggle').addEventListener('click', () => {
      document.getElementById('sidebar').classList.toggle('open');
    });

    // ===== CARREGAR USUÁRIO =====
    async function carregarUsuario(id) {
      try {
        const response = await fetch(`${API_URL}/users/${id}`);
        if (!response.ok) throw new Error('Usuário não encontrado');
        usuarioAtual = await response.json();
        preencherDadosUsuario();
        carregarAbas();
        document.getElementById('loading').style.display = 'none';
        document.getElementById('userContent').style.display = 'block';
      } catch (error) {
        document.getElementById('loading').innerHTML = `<p style="color:#ff6b6b;">${error.message}</p>`;
        console.error('Erro:', error);
      }
    }

    function preencherDadosUsuario() {
      document.getElementById('userAvatar').textContent = usuarioAtual.nome ? usuarioAtual.nome.charAt(0).toUpperCase() : '?';
      document.getElementById('userName').textContent = usuarioAtual.nome || '-';
      document.getElementById('userUsername').textContent = usuarioAtual.username || '-';
      document.getElementById('userDbId').textContent = usuarioAtual.id;
      document.getElementById('userTelegramId').textContent = usuarioAtual.telegram_id || '-';
      document.getElementById('userEmail').textContent = usuarioAtual.email || '-';
      document.getElementById('userWhatsapp').textContent = usuarioAtual.whatsapp || '-';
      document.getElementById('userBalance').textContent = 'R$ ' + (parseFloat(usuarioAtual.saldo) || 0).toFixed(2);
      document.getElementById('userPurchases').textContent = usuarioAtual.compras || 0;
      document.getElementById('userAffiliate').textContent = usuarioAtual.afiliado ? 'Sim' : 'Não';
      document.getElementById('userStatus').innerHTML = usuarioAtual.status === 'ativo'
        ? '<span class="status-badge status-active">Ativo</span>'
        : '<span class="status-badge status-blocked">Bloqueado</span>';
      document.getElementById('btnToggleStatus').textContent = usuarioAtual.status === 'ativo' ? '🚫 Bloquear' : '🔓 Desbloquear';
    }

    // ===== TABS =====
    async function carregarAbas() {
      // Inicialmente carrega a aba ativa (compras)
      carregarCompras();
      // As demais são carregadas sob demanda
    }

    async function carregarCompras() {
      const container = document.getElementById('tab-compras');
      container.innerHTML = '<div class="loading"><div class="spinner"></div></div>';
      try {
        const response = await fetch(`${API_URL}/users/${usuarioAtual.id}/orders`);
        if (!response.ok) throw new Error('Erro ao carregar compras');
        const data = await response.json();
        if (data.length === 0) {
          container.innerHTML = '<p>Nenhuma compra encontrada.</p>';
          return;
        }
        let html = '<h3>Histórico de Compras</h3><table><thead><tr><th>Pedido</th><th>Produto</th><th>Valor</th><th>Data</th><th>Status</th></tr></thead><tbody>';
        data.forEach(order => {
          html += `<tr>
            <td>#${order.id}</td>
            <td>${order.produto_nome || '-'}</td>
            <td>R$ ${parseFloat(order.valor).toFixed(2)}</td>
            <td>${order.data}</td>
            <td><span class="status-badge ${order.status === 'aprovado' ? 'status-approved' : 'status-pending'}">${order.status}</span></td>
          </tr>`;
        });
        html += '</tbody></table>';
        container.innerHTML = html;
      } catch (error) {
        container.innerHTML = `<p style="color:#ff6b6b;">${error.message}</p>`;
      }
    }

    async function carregarRecargas() {
      const container = document.getElementById('tab-recargas');
      container.innerHTML = '<div class="loading"><div class="spinner"></div></div>';
      try {
        const response = await fetch(`${API_URL}/users/${usuarioAtual.id}/recargas`);
        if (!response.ok) throw new Error('Erro ao carregar recargas');
        const data = await response.json();
        if (data.length === 0) {
          container.innerHTML = '<p>Nenhuma recarga encontrada.</p>';
          return;
        }
        let html = '<h3>Histórico de Recargas</h3><table><thead><tr><th>ID</th><th>Valor</th><th>Bônus</th><th>Data</th><th>Status</th></tr></thead><tbody>';
        data.forEach(recarga => {
          html += `<tr>
            <td>#${recarga.id}</td>
            <td>R$ ${parseFloat(recarga.valor).toFixed(2)}</td>
            <td>R$ ${parseFloat(recarga.bonus || 0).toFixed(2)}</td>
            <td>${recarga.data}</td>
            <td><span class="status-badge ${recarga.status === 'aprovado' ? 'status-approved' : 'status-pending'}">${recarga.status}</span></td>
          </tr>`;
        });
        html += '</tbody></table>';
        container.innerHTML = html;
      } catch (error) {
        container.innerHTML = `<p style="color:#ff6b6b;">${error.message}</p>`;
      }
    }

    async function carregarAfiliados() {
      const container = document.getElementById('tab-afiliados');
      container.innerHTML = '<div class="loading"><div class="spinner"></div></div>';
      try {
        const response = await fetch(`${API_URL}/users/${usuarioAtual.id}/affiliate`);
        if (!response.ok) throw new Error('Erro ao carregar dados de afiliado');
        const data = await response.json();
        let html = '<h3>Informações de Afiliado</h3>';
        html += `<p><strong>Link:</strong> ${data.link || '-'}</p>`;
        html += `<p><strong>Total de Indicações:</strong> ${data.total_indicacoes || 0}</p>`;
        html += `<p><strong>Comissões Ganhas:</strong> R$ ${parseFloat(data.total_comissoes || 0).toFixed(2)}</p>`;
        html += `<p><strong>Saldo de Comissões:</strong> R$ ${parseFloat(data.saldo_comissoes || 0).toFixed(2)}</p>`;
        container.innerHTML = html;
      } catch (error) {
        container.innerHTML = `<p style="color:#ff6b6b;">${error.message}</p>`;
      }
    }

    async function carregarAlertas() {
      const container = document.getElementById('tab-alertas');
      container.innerHTML = '<div class="loading"><div class="spinner"></div></div>';
      try {
        const response = await fetch(`${API_URL}/users/${usuarioAtual.id}/alerts`);
        if (!response.ok) throw new Error('Erro ao carregar alertas');
        const data = await response.json();
        if (data.length === 0) {
          container.innerHTML = '<p>Nenhum alerta ativo.</p>';
          return;
        }
        let html = '<h3>Alertas de Estoque</h3><ul>';
        data.forEach(alerta => {
          html += `<li>${alerta.produto_nome} (${alerta.ativo ? 'ativo' : 'inativo'})</li>`;
        });
        html += '</ul>';
        container.innerHTML = html;
      } catch (error) {
        container.innerHTML = `<p style="color:#ff6b6b;">${error.message}</p>`;
      }
    }

    async function carregarLogs() {
      const container = document.getElementById('tab-logs');
      container.innerHTML = '<div class="loading"><div class="spinner"></div></div>';
      try {
        const response = await fetch(`${API_URL}/users/${usuarioAtual.id}/logs`);
        if (!response.ok) throw new Error('Erro ao carregar logs');
        const data = await response.json();
        if (data.length === 0) {
          container.innerHTML = '<p>Nenhum log encontrado.</p>';
          return;
        }
        let html = '<h3>Logs de Atividades</h3><table><thead><tr><th>Data/Hora</th><th>Ação</th><th>Detalhes</th></tr></thead><tbody>';
        data.forEach(log => {
          html += `<tr><td>${log.data_hora}</td><td>${log.acao}</td><td>${log.detalhes || '-'}</td></tr>`;
        });
        html += '</tbody></table>';
        container.innerHTML = html;
      } catch (error) {
        container.innerHTML = `<p style="color:#ff6b6b;">${error.message}</p>`;
      }
    }

    // ===== NAVEGAÇÃO DAS TABS =====
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        tabButtons.forEach(b => b.classList.remove('active'));
        tabContents.forEach(c => c.classList.remove('active'));
        btn.classList.add('active');
        const tabId = btn.dataset.tab;
        document.getElementById('tab-' + tabId).classList.add('active');
        // Carrega conteúdo sob demanda
        switch (tabId) {
          case 'compras': carregarCompras(); break;
          case 'recargas': carregarRecargas(); break;
          case 'afiliados': carregarAfiliados(); break;
          case 'alertas': carregarAlertas(); break;
          case 'logs': carregarLogs(); break;
        }
      });
    });

    // ===== AÇÕES =====
    async function toggleStatus() {
      const novoStatus = usuarioAtual.status === 'ativo' ? 'bloqueado' : 'ativo';
      try {
        const response = await fetch(`${API_URL}/users/${usuarioAtual.id}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: novoStatus })
        });
        if (!response.ok) throw new Error('Erro ao alterar status');
        usuarioAtual.status = novoStatus;
        preencherDadosUsuario();
      } catch (error) {
        alert('Erro ao alterar status.');
        console.error('Erro:', error);
      }
    }

    async function confirmarAjuste() {
      const valor = parseFloat(document.getElementById('ajusteValor').value);
      const motivo = document.getElementById('ajusteMotivo').value.trim();
      if (!valor || !motivo) {
        alert('Preencha valor e motivo.');
        return;
      }
      try {
        const response = await fetch(`${API_URL}/users/${usuarioAtual.id}/wallet/adjust`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ valor, motivo })
        });
        if (!response.ok) throw new Error('Erro ao ajustar saldo');
        const data = await response.json();
        usuarioAtual.saldo = data.novo_saldo;
        preencherDadosUsuario();
        fecharModal('modalAjustarSaldo');
        document.getElementById('ajusteValor').value = '';
        document.getElementById('ajusteMotivo').value = '';
        alert('Saldo ajustado com sucesso.');
      } catch (error) {
        alert('Erro ao ajustar saldo.');
        console.error('Erro:', error);
      }
    }

    async function confirmarEnvioMensagem() {
      const texto = document.getElementById('mensagemTexto').value.trim();
      if (!texto) {
        alert('Digite a mensagem.');
        return;
      }
      try {
        const response = await fetch(`${API_URL}/users/${usuarioAtual.id}/message`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mensagem: texto })
        });
        if (!response.ok) throw new Error('Erro ao enviar mensagem');
        fecharModal('modalEnviarMensagem');
        document.getElementById('mensagemTexto').value = '';
        alert('Mensagem enviada.');
      } catch (error) {
        alert('Erro ao enviar mensagem.');
        console.error('Erro:', error);
      }
    }

    // ===== MODAL =====
    function abrirModal(id) { document.getElementById(id).classList.add('show'); }
    function fecharModal(id) { document.getElementById(id).classList.remove('show'); }
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', function(e) {
        if (e.target === this) this.classList.remove('show');
      });
    });
  </script>
</body>
</html>
